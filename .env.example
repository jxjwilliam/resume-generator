# ─── Active LLM provider ───────────────────────────────────────
# Options: deepseek | kimi | minimax
LLM_PROVIDER=deepseek

# ─── DeepSeek (https://platform.deepseek.com) ─────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Resume/JD tasks: deepseek-v4-pro (recommended) | deepseek-reasoner
DEEPSEEK_MODEL=deepseek-v4-pro

# ─── Kimi / Moonshot — China inland (https://platform.moonshot.cn) ─
# International: KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=sk-your-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
# Popular models: kimi-k2.5 | kimi-k2-0905-preview | moonshot-v1-32k | moonshot-v1-128k
KIMI_MODEL=kimi-k2.5

# ─── MiniMax — China inland (https://platform.minimaxi.com) ───
# International: MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=sk-api-your-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# Popular models: MiniMax-M2.5 | MiniMax-M2.5-highspeed | MiniMax-M2.7 | MiniMax-M3
MINIMAX_MODEL=MiniMax-M2.5

